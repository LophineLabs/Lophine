diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index e8104fec9acc0eb6f8b029d5b57a4a68f38634a0..26579b70943444c705faf67632e9d172a3ed3c65 100644

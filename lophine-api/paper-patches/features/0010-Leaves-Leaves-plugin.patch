diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index af827f4eb738bc236fb2088d3d4ac0b1a6b2d752..c36ec5f259c51cd2202db487eb089c1433ef6414 100644

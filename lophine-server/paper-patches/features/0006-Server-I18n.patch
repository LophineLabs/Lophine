+    private static ANSIComponentSerializer wrapAnsi(final ANSIComponentSerializer inner) {
+        return new ANSIComponentSerializer() {
+            @Override
+            public @NotNull String serialize(final @NotNull Component component) {
+                return inner.serialize(fun.bm.lophine.utils.I18nBidi.visual(component, FLATTENER));
+            }
+        };
+    }

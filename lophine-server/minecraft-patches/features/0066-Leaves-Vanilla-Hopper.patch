+                container.setItem(i, origItemStack);
+                container.setChanged();
+                return true;
+            }
             origItemStack.setCount(originalItemCount);
-            if (!origItemStack.isEmpty()) {
-                origItemStack.setCount(originalItemCount - movedItemCount + remainingItemCount);
+            container.setItem(i, origItemStack);
+        } else {

+    /** AMS grants one recipe at a time, awaiting each real event, criterion and physical packet. */
+    public java.util.concurrent.CompletableFuture<Integer> carpetAddRecipeNative(final RecipeHolder<?> recipe, final ServerPlayer player) {
+        var prepared = fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+            ResourceKey<Recipe<?>> id = recipe.id();
+            if (this.known.contains(id) || recipe.value().isSpecial()) return null;
+            return org.bukkit.craftbukkit.event.CraftEventFactory.callPlayerRecipeListUpdateEvent(player, recipe);
+        });
+        return fun.bm.lophine.carpet.AmsNativeCommandEffects.then(prepared, event -> {
+            if (event == null) return java.util.concurrent.CompletableFuture.completedFuture(0);
+            var entries = fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+                if (event.isCancelled()) return null;
+                this.add(recipe.id()); this.addHighlight(recipe.id());
+                List<ClientboundRecipeBookAddPacket.Entry> result = new ArrayList<>();
+                this.displayResolver.displaysForRecipe(recipe.id(), display -> result.add(new ClientboundRecipeBookAddPacket.Entry(display, event.shouldShowNotification(), true)));
+                return result;
+            });
+            return fun.bm.lophine.carpet.AmsNativeCommandEffects.then(entries, result -> {
+                if (result == null) return java.util.concurrent.CompletableFuture.completedFuture(0);
+                var criterion = fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+                    CriteriaTriggers.RECIPE_UNLOCKED.trigger(player, recipe); return (Void)null;
+                });
+                return fun.bm.lophine.carpet.AmsNativeCommandEffects.then(criterion, ignored ->
+                    fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+                        if (!result.isEmpty() && player.connection != null)
+                            return fun.bm.lophine.carpet.AmsNativeCommandEffects.packet(player, new ClientboundRecipeBookAddPacket(result, false)).thenApply(sent -> result.size());
+                        return java.util.concurrent.CompletableFuture.completedFuture(result.size());
+                    }).thenCompose(value -> value));
+            });
+        });
+    }

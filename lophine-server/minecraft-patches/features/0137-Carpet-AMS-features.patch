+    /** Reload completion follows the real owner-side command packet, including command-send events. */
+    public java.util.concurrent.CompletableFuture<Void> carpetReloadCommands(final ServerPlayer player) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(player, "Reload command preparation must own the player");
+        var actual = new java.util.concurrent.CompletableFuture<Void>() {
+            @Override public boolean cancel(boolean interrupt) { return false; }
+        };
+        carpet.script.external.ScarpetNativeWork.record(actual);
+        carpet.script.external.ScarpetNativeWork.trackNative(player.carpetSpawnServer(), actual);
+        var prepared = fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+            RootCommandNode<CommandSourceStack> root = new RootCommandNode<>();
+            if (org.spigotmc.SpigotConfig.tabComplete < 0) return new CarpetPreparedCommands(root, java.util.List.of(), true);
+            var children = new java.util.ArrayList<>(this.dispatcher.getRoot().getChildren());
+            RootCommandNode<CommandSourceStack> snapshot = new RootCommandNode<>();
+            children.forEach(snapshot::addChild);
+            Map<CommandNode<CommandSourceStack>, CommandNode<CommandSourceStack>> converted = new HashMap<>();
+            converted.put(this.dispatcher.getRoot(), root);
+            fillUsableCommands(snapshot, root, player.createCommandSourceStack(), converted);
+            java.util.Collection<String> labels = new java.util.LinkedHashSet<>();
+            for (var node : root.getChildren()) labels.add(node.getName());
+            return new CarpetPreparedCommands(root, labels, false);
+        });
+        var built = fun.bm.lophine.carpet.AmsNativeCommandEffects.then(prepared, ready -> {
+            if (ready.empty()) return java.util.concurrent.CompletableFuture.completedFuture(ready);
+            var event = new java.util.concurrent.CompletableFuture<Void>();
+            carpet.script.external.ScarpetNativeWork.record(event);
+            var captured = carpet.script.external.ScarpetRuntime.captureNativeContinuation(() -> {
+                var observed = carpet.script.external.ScarpetNativeWork.<Void>observeNative(null, () -> {
+                    new com.destroystokyo.paper.event.brigadier.AsyncPlayerSendCommandsEvent<CommandSourceStack>(player.getBukkitEntity(), ready.root(), false).callEvent();
+                    return null;
+                });
+                carpet.script.external.ScarpetNativeWork.recoverGuestValue(observed).whenComplete((value, failure) -> {
+                    if (failure == null) event.complete(null); else event.completeExceptionally(failure);
+                });
+                return (Void)null;
+            });
+            try {
+                COMMAND_SENDING_POOL.execute(new CarpetReloadCommandTask(captured, event));
+            } catch (Throwable failure) { event.completeExceptionally(failure); }
+            return fun.bm.lophine.carpet.AmsNativeCommandEffects.then(event, ignored -> java.util.concurrent.CompletableFuture.completedFuture(ready));
+        });
+        var packet = fun.bm.lophine.carpet.AmsNativeCommandEffects.then(built, ready -> fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+            if (player.hasDisconnected()) return null;
+            return ready.empty() ? new ClientboundCommandsPacket(ready.root(), COMMAND_NODE_INSPECTOR)
+                : this.carpetBuildCommandsPacket(player, ready.labels(), ready.root());
+        }));
+        var sent = fun.bm.lophine.carpet.AmsNativeCommandEffects.then(packet, ready -> ready == null ? java.util.concurrent.CompletableFuture.<Void>completedFuture(null)
+            : fun.bm.lophine.carpet.AmsNativeCommandEffects.owned(player, () -> {
+                if (!player.hasDisconnected()) fun.bm.lophine.carpet.AmsNativeCommandEffects.packet(player, ready);
+                return (Void)null;
+            }));
+        carpet.script.external.ScarpetNativeWork.aliasDependency(actual, sent);
+        sent.whenComplete((value, failure) -> { if (failure == null) actual.complete(null); else actual.completeExceptionally(failure); });
+        return actual;
+    }
+    private record CarpetPreparedCommands(RootCommandNode<CommandSourceStack> root, java.util.Collection<String> labels, boolean empty) {}
+    private static final class CarpetReloadCommandTask extends java.util.concurrent.FutureTask<Void> {
+        private final java.util.concurrent.CompletableFuture<Void> receipt;
+        CarpetReloadCommandTask(java.util.function.Supplier<Void> operation, java.util.concurrent.CompletableFuture<Void> receipt) {
+            super(() -> { try { return operation.get(); } catch (Throwable failure) { receipt.completeExceptionally(failure); return null; } });
+            this.receipt = receipt;
+        }
+        void reject() { this.receipt.completeExceptionally(new java.util.concurrent.RejectedExecutionException("Command sending pool rejected a reload")); }
+    }
+
     // Fixed pool, but with discard policy
     public static final java.util.concurrent.ExecutorService COMMAND_SENDING_POOL = new java.util.concurrent.ThreadPoolExecutor(
         2, 2, 0, java.util.concurrent.TimeUnit.MILLISECONDS,

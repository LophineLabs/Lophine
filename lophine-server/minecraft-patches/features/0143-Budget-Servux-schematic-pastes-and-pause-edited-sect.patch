From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wdsj-cmd <125710718+wdsj-cmd@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:38:35 +0800
Subject: [PATCH] Budget Servux schematic pastes and pause edited sections

Use spare region tick time for bounded paste slices. Pause random ticks, block entities, precipitation and block events in claimed sections; keep due block/fluid ticks in their native queues. Cancel queued pastes before shutdown drains accepted native work.

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 014346dd80d5093b45c07951f1e21061fbb46239..829576cd265e46e71b7d2751d449b25f15e3e8e0 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1046,6 +1046,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     public void stopServer() { // Folia - region threading - public
         this.tickRateManager.carpetSetDeeplyFrozen(false);
+        org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.shutdown(this); // Lophine - cancel queued Servux pastes before native draining
         carpet.script.external.ScarpetNativeWork.beginDrain(this);
         fun.bm.lophine.carpet.CarpetRegionLease.beginShutdown(this);
         fun.bm.lophine.carpet.tis.TisProjectileVisualizer.clearAtShutdown(this);
@@ -1216,6 +1217,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     public void halt(final boolean wait, final boolean isRestarting, boolean force) {
         this.tickRateManager.carpetSetDeeplyFrozen(false);
+        org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.shutdown(this); // Lophine - cancel queued Servux pastes before native draining
         carpet.script.external.ScarpetNativeWork.beginDrain(this);
         fun.bm.lophine.carpet.CarpetRegionLease.beginShutdown(this);
         fun.bm.lophine.carpet.tis.TisProjectileVisualizer.clearAtShutdown(this);
@@ -1867,6 +1869,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         ProfilerFiller profiler = Profiler.get();
         //this.server.spark.executeMainThreadTasks(); // Paper - spark // Folia - region threading
+        if (region != null) org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.tick(region.world, scheduledEnd); // Lophine - use spare region tick time for Servux
         // Paper start - Server Tick Events
         long endTime = System.nanoTime();
         long remaining = scheduledEnd - endTime; // Folia - region ticking
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java

@@ -958,9 +971,24 @@ public final class StarLightInterface {
 
             @Override
             public void run() {
-                ((ServerLightQueue)this.queue).chunkTasks.remove(this.chunkCoordinate, this);
-
-                this.runTasks();
+                try {
+                    // The Moonrise worker replaces vanilla ThreadedLevelLightEngine.runUpdate.
+                    // Pausing here retains the queued changes until the server rule is restored.
+                    while (!Thread.currentThread().isInterrupted()) {
+                        if (carpet.script.external.ScarpetNativeWork.isDraining(((ServerLevel)this.queue.lightInterface.getWorld()).getServer())) break;
+                        String mode = fun.bm.lophine.carpet.config.modules.GeneralCompatConfig.lightUpdates;
+                        if (!"suppressed".equals(mode) && !"off".equals(mode)) {
+                            break;
+                        }
+                        java.util.concurrent.locks.LockSupport.parkNanos(1_000_000L);
+                    }
+                    ((ServerLightQueue)this.queue).chunkTasks.remove(this.chunkCoordinate, this);
+                    ((ServerLightQueue)this.queue).carpetQueueSize.decrementAndGet();
+                    ((ServerLightQueue)this.queue).carpetExecutedTasks.incrementAndGet();
+                    this.runTasks();
+                } finally {
+                    ((ServerLightQueue)this.queue).carpetPendingTasks.remove(this);
+                }
             }
         }
     }

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Tue, 22 Aug 2023 21:38:37 +0200
Subject: [PATCH] Gale: Optimize VarLong sizing and writes

Compute encoded size from the highest set bit. Combine the byte groups when sufficient space is already writable, using explicit little-endian writes for identical bytes on either buffer byte order. Keep the bytewise path for growth and capacity errors.

Gale: https://galemc.org
Original patch: https://github.com/Winds-Studio/Leaf/blob/06c9c91a17e61aeed16bcfc846ebe91aa70d6c84/leaf-server/minecraft-patches/features/0073-Optimize-VarInt-write-and-VarLong-write.patch
Based on Andrew Steinborn's Velocity VarInt optimization: https://github.com/PaperMC/Velocity
License: GPL-3.0-only (https://www.gnu.org/licenses/gpl-3.0.html)

diff --git a/net/minecraft/network/VarLong.java b/net/minecraft/network/VarLong.java
index c243c6d19f580f0b3337e946f5a108e0ee2b55d4..4933cc1bdd3ba0482750ce8131a720944735ffdd 100644
--- a/net/minecraft/network/VarLong.java
+++ b/net/minecraft/network/VarLong.java
@@ -9,13 +9,10 @@ public class VarLong {
     private static final int DATA_BITS_PER_BYTE = 7;
 
     public static int getByteSize(final long value) {
-        for (int i = 1; i < MAX_VARLONG_SIZE; i++) {
-            if ((value & -1L << i * DATA_BITS_PER_BYTE) == 0L) {
-                return i;
-            }
-        }
-
-        return MAX_VARLONG_SIZE;
+        // Gale start - Velocity - optimize VarLong size
+        final int dataBits = Long.SIZE - Long.numberOfLeadingZeros(value);
+        return Math.max(1, (dataBits + DATA_BITS_PER_BYTE - 1) / DATA_BITS_PER_BYTE);
+        // Gale end - Velocity - optimize VarLong size
     }
 
     public static boolean hasContinuationBit(final byte in) {
@@ -39,6 +36,31 @@ public class VarLong {
     }
 
     public static ByteBuf write(final ByteBuf output, long value) {
+        // Gale start - Velocity - optimized VarLong#write
+        if ((value >>> DATA_BITS_PER_BYTE) == 0) {
+            output.writeByte((int)value);
+            return output;
+        }
+
+        int remaining = getByteSize(value);
+        if (output.writableBytes() >= remaining) {
+            while (remaining > Integer.BYTES) {
+                output.writeIntLE(packFourGroups((int)value) | 0x80808080);
+                value >>>= DATA_BITS_PER_BYTE * Integer.BYTES;
+                remaining -= Integer.BYTES;
+            }
+
+            final int tail = packFourGroups((int)value);
+            switch (remaining) {
+                case 1 -> output.writeByte(tail);
+                case 2 -> output.writeShortLE(tail | 0x80);
+                case 3 -> output.writeMediumLE(tail | 0x8080);
+                case 4 -> output.writeIntLE(tail | 0x808080);
+            }
+            return output;
+        }
+        // Gale end - Velocity - optimized VarLong#write
+
         while ((value & -128L) != 0L) {
             output.writeByte((int)(value & DATA_BITS_MASK) | CONTINUATION_BIT_MASK);
             value >>>= DATA_BITS_PER_BYTE;
@@ -47,4 +69,13 @@ public class VarLong {
         output.writeByte((int)value);
         return output;
     }
+
+    // Gale start - Velocity - optimized VarLong#write
+    private static int packFourGroups(final int value) {
+        return (value & 0x7F)
+            | ((value & 0x3F80) << 1)
+            | ((value & 0x1FC000) << 2)
+            | ((value & 0xFE00000) << 3);
+    }
+    // Gale end - Velocity - optimized VarLong#write
 }

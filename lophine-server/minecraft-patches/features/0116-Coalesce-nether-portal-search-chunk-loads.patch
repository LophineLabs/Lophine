From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Sat, 22 Aug 2026 15:00:00 +0800
Subject: [PATCH] Coalesce nether portal search chunk loads

Keep Moonrise responsible for chunk tickets and share only identical
in-flight portal search area loads. This avoids the custom reference-counted
ticket cache while preventing every entity in a high-throughput farm from
scheduling the same chunk area independently.

Also honor the requested chunk status in Moonrise's async area loader instead
of forcing every request to FULL. Portal searches request EMPTY explicitly.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 36100598cd7c861dd2e7d6fe5a46d10755241b30..c6d88dce325f99dd7179fc6c203f86ebafd947a2 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -223,6 +223,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     private final StructureCheck structureCheck;
     public final boolean tickTime; // Folia - region threading
     private final LevelDebugSynchronizers debugSynchronizers = new LevelDebugSynchronizers(this);
+    public final fun.bm.lophine.utils.PortalSearchChunkLoadCoordinator portalSearchChunkLoadCoordinator = new fun.bm.lophine.utils.PortalSearchChunkLoadCoordinator(this); // Lophine - coalesce portal search area loads
     // Luminol start - Level schedulers
     private static final java.util.concurrent.atomic.AtomicInteger UNLOADER_ID_GEN = new java.util.concurrent.atomic.AtomicInteger(0);
     public final me.earthme.luminol.utils.thread.LevelAwareRegionScheduler levelScheduler = new me.earthme.luminol.utils.thread.LevelAwareRegionScheduler(io.papermc.paper.threadedregions.TickRegions.getScheduler().scheduler);
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index d94176516f64679c50c0024aea25e5eef80556aa..d188e0d9128d0a76ac6dcd7f700291ead384519a 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -4977,10 +4977,10 @@ public abstract class Entity
                 );
 
                 // kick off search for existing portal or creation
-                destination.moonrise$loadChunksAsync(
+                destination.portalSearchChunkLoadCoordinator.loadChunksAsync( // Lophine - coalesce portal search area loads
                     // add 32 so that the final search for a portal frame doesn't load any chunks
                     targetPos, portalSearchRadius + 32,
-                    net.minecraft.world.level.chunk.status.ChunkStatus.EMPTY,
+                    // ChunkStatus.EMPTY is supplied by the coordinator
                     ca.spottedleaf.concurrentutil.util.Priority.HIGH,
                     (chunks) -> {
                         BlockUtil.FoundRectangle portal =

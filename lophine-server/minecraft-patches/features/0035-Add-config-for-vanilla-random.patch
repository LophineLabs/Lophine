diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 2a8dbd21313deef0174069507bb119f7ec50903b..daf86f402e1e1894b4db42ceac8c9af6ab22830f 100644

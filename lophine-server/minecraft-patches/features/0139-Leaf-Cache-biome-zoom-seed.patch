From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hayanesuru <hayanesuru@outlook.jp>
Date: Sat, 1 Aug 2026 08:56:01 +0900
Subject: [PATCH] Leaf: Cache biome zoom seed

Compute the vanilla hashed seed once per WorldOptions and reuse it for world creation, chunk generation, and player spawn info. The seed and world settings codec are unchanged.

Original patch: https://github.com/Winds-Studio/Leaf/blob/06c9c91a17e61aeed16bcfc846ebe91aa70d6c84/leaf-server/minecraft-patches/features/0216-cache-biome-zoom-seed.patch

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 0564d53dde7c95051359d4adb3bab431ad79dc97..c5436995d353d8d45eb4d484b3383b7b7fc47040 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -154,7 +154,6 @@ import net.minecraft.world.level.Level;
 import net.minecraft.world.level.LevelSettings;
 import net.minecraft.world.level.TicketStorage;
 import net.minecraft.world.level.WorldDataConfiguration;
-import net.minecraft.world.level.biome.BiomeManager;
 import net.minecraft.world.level.block.Block;
 import net.minecraft.world.level.chunk.status.ChunkStatus;
 import net.minecraft.world.level.chunk.storage.ChunkIOErrorReporter;
@@ -696,8 +695,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         final ResourceKey<Level> dimensionKey = loading.info().dimensionKey();
         final SavedDataStorage savedDataStorage = new SavedDataStorage(this.storageSource.getDimensionPath(dimensionKey).resolve(LevelResource.DATA.id()), this.getFixerUpper(), this.registryAccess());
         savedDataStorage.set(WorldGenSettings.TYPE, new WorldGenSettings(worldDataAndGenSettings.genSettings().options(), worldDataAndGenSettings.genSettings().dimensions()));
-        long seed = worldOptions.seed();
-        long biomeZoomSeed = BiomeManager.obfuscateSeed(seed);
+        long biomeZoomSeed = worldOptions.biomeZoomSeed(); // Leaf - cache biome zoom seed
         List<CustomSpawner> overworldCustomSpawners = ImmutableList.of(
             new PhantomSpawner(), new PatrolSpawner(), new CatSpawner(), new VillageSiege(), new WanderingTraderSpawner(savedDataStorage) // Paper - save to world data
         );
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index d7a5bae03b6033c3b7ba9e58701df75ce9eae15b..37aa2da2b0eefbceabc42bd52901563cdc8f41fa 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -178,7 +178,6 @@ import net.minecraft.world.item.trading.MerchantOffers;
 import net.minecraft.world.level.ChunkPos;
 import net.minecraft.world.level.GameType;
 import net.minecraft.world.level.Level;
-import net.minecraft.world.level.biome.BiomeManager;
 import net.minecraft.world.level.block.AbstractBedBlock;
 import net.minecraft.world.level.block.Block;
 import net.minecraft.world.level.block.HorizontalDirectionalBlock;
@@ -3706,7 +3705,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         return new CommonPlayerSpawnInfo(
             level.dimensionTypeRegistration(),
             level.dimension(),
-            BiomeManager.obfuscateSeed(level.getSeed()),
+            level.worldGenSettings.options().biomeZoomSeed(), // Leaf - cache biome zoom seed
             this.gameMode.getGameModeForPlayer(),
             Optional.ofNullable(this.gameMode.getPreviousGameModeForPlayer()),
             level.isDebug(),
diff --git a/net/minecraft/server/level/WorldGenRegion.java b/net/minecraft/server/level/WorldGenRegion.java
index 0fee2fea9f1d73840608c3f5c30f29f7e26e94e0..c4f081a0dd276e4851c8411ae7e2344168430aeb 100644
--- a/net/minecraft/server/level/WorldGenRegion.java
+++ b/net/minecraft/server/level/WorldGenRegion.java
@@ -138,7 +138,7 @@ public class WorldGenRegion implements WorldGenLevel {
         this.random = randomState.getOrCreateRandomFactory(WORLDGEN_REGION_RANDOM).at(this.center.getPos().getWorldPosition());
         this.dimensionType = level.dimensionType();
         this.uncachedBiomeResolver = level.uncachedBiomeResolver();
-        this.biomeManager = new BiomeManager(this, BiomeManager.obfuscateSeed(this.seed));
+        this.biomeManager = new BiomeManager(this, level.worldGenSettings.options().biomeZoomSeed()); // Leaf - cache biome zoom seed
         ChunkPos centerPos = center.getPos();
         this.centerChunkX = centerPos.x();
         this.centerChunkZ = centerPos.z();
diff --git a/net/minecraft/world/level/levelgen/WorldOptions.java b/net/minecraft/world/level/levelgen/WorldOptions.java
index a5201850d69248cd3535f545bf54c2258bd6b42c..437041422da776b35b7de1e339bdfc448720db82 100644
--- a/net/minecraft/world/level/levelgen/WorldOptions.java
+++ b/net/minecraft/world/level/levelgen/WorldOptions.java
@@ -38,6 +38,7 @@ public class WorldOptions {
         : new WorldOptions("North Carolina".hashCode(), true, true);
     // Leaf end - Matter - Secure Seed
     private final long seed;
+    private final long biomeZoomSeed; // Leaf - cache biome zoom seed
     private long[] featureSeed = su.plo.matter.Globals.createRandomWorldSeed(); // Leaf - Matter - Secure Seed
     private final boolean generateStructures;
     private final boolean generateBonusChest;
@@ -79,8 +80,15 @@ public class WorldOptions {
         this.generateStructures = generateStructures;
         this.generateBonusChest = generateBonusChest;
         this.legacyCustomOptions = legacyCustomOptions;
+        this.biomeZoomSeed = net.minecraft.world.level.biome.BiomeManager.obfuscateSeed(seed); // Leaf - cache biome zoom seed
     }
 
+    // Leaf start - cache biome zoom seed
+    public long biomeZoomSeed() {
+        return this.biomeZoomSeed;
+    }
+    // Leaf end - cache biome zoom seed
+
     public long seed() {
         return this.seed;
     }

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Helvetica Volubi <suisuroru@blue-millennium.fun>
Date: Mon, 21 Sep 2026 01:02:22 +0800
Subject: [PATCH] Fix a command async problem if a plugin modify command node
 when player join the server


diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 8db0bf6c5500fab0b278a9afdf8c2c161097a5d3..dd9c5b7f8c0d07e3aaa7ca257b40dc3c57961692 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -519,7 +519,22 @@ public class Commands {
         RootCommandNode<CommandSourceStack> root = new RootCommandNode<>();
         // Paper start - Perf: Async command map building; pass copy of root
         playerCommands.put(dispatcherRoot, root);
-        fillUsableCommands(dispatcherRoot, root, player.createCommandSourceStack(), playerCommands);
+        // Lophine start - fix command null problem
+        try {
+            fillUsableCommands(dispatcherRoot, root, player.createCommandSourceStack(), playerCommands); // Paper - Perf: Async command map building; pass copy of children
+        } catch (java.util.ConcurrentModificationException e) {
+            net.minecraft.server.MinecraftServer.LOGGER.warn(e.getMessage());
+            org.bukkit.Bukkit.getGlobalRegionScheduler().runDelayed(org.leavesmc.leaves.plugin.MinecraftInternalPlugin.INSTANCE,
+                    _ -> {
+                        synchronized (player) {
+                            net.minecraft.server.MinecraftServer.LOGGER.info("Retrying command send for {}, UUID: {}", player, player.getUUID());
+                            if (!player.hasDisconnected()) {
+                                this.sendAsync(player, dispatcherRoot);
+                            }
+                        }
+                    }, 20L);
+        }
+        // Lophine end - fix command null problem
         // Paper end - Perf: Async command map building; pass copy of root
 
         java.util.Collection<String> bukkit = new java.util.LinkedHashSet<>();
@@ -555,6 +570,11 @@ public class Commands {
         final CommandNode<S> source, final CommandNode<S> target, final S commandFilter, final Map<CommandNode<S>, CommandNode<S>> converted
     ) {
         for (CommandNode<S> child : source.getChildren()) {
+            // Lophine start - fix command null problem
+            if (child == null) {
+                throw new java.util.ConcurrentModificationException("Command Node was edited while building command list.");
+            }
+            // Lophine end - fix command null problem
             // Paper start - Brigadier API
             if (child.clientNode != null) {
                 child = child.clientNode;

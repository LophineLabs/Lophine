From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hayanesuru <hayanesuru@outlook.jp>
Date: Wed, 29 Jul 2026 12:52:50 +0900
Subject: [PATCH] Leaf: Reduce command tree node lookups

Insert a new command node with one hash table probe and enqueue its children and redirect only if insertion changed the map size. Retain the original breadth-first numbering and default return value.

Original patch: https://github.com/Winds-Studio/Leaf/blob/06c9c91a17e61aeed16bcfc846ebe91aa70d6c84/leaf-server/minecraft-patches/features/0291-optimize-ClientboundCommandsPacket-enumerateNodes.patch

diff --git a/net/minecraft/network/protocol/game/ClientboundCommandsPacket.java b/net/minecraft/network/protocol/game/ClientboundCommandsPacket.java
index c87aabe87cdb6eb05bb6a39e3eda2af14415f978..29019439b625e28b0b7024d90327882b9c04d4f2 100644
--- a/net/minecraft/network/protocol/game/ClientboundCommandsPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundCommandsPacket.java
@@ -84,14 +84,16 @@ public class ClientboundCommandsPacket implements Packet<ClientGamePacketListene
 
         CommandNode<S> node;
         while ((node = queue.poll()) != null) {
-            if (!nodeToId.containsKey(node)) {
-                int id = nodeToId.size();
-                nodeToId.put(node, id);
+            // Leaf start - optimize ClientboundCommandsPacket#enumerateNodes
+            final int id = nodeToId.size();
+            nodeToId.putIfAbsent(node, id);
+            if (nodeToId.size() != id) {
                 queue.addAll(node.getChildren());
                 if (node.getRedirect() != null) {
                     queue.add(node.getRedirect());
                 }
             }
+            // Leaf end - optimize ClientboundCommandsPacket#enumerateNodes
         }
 
         return nodeToId;

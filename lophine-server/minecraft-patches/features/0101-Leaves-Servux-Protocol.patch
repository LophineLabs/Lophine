From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Helvetica Volubi <suisuroru@blue-millennium.fun>
Date: Sun, 3 Aug 2025 15:19:23 +0800
Subject: [PATCH] Leaves: Servux Protocol

Co-authored by: violetc <58360096+s-yh-china@users.noreply.github.com>
As a part of : Leaves (https://github.com/LeavesMC/Leaves/blob/ea91106ae57fc4cc14e2e0225009cf9919072f7f/leaves-server/minecraft-patches/features/0090-Servux-Protocol.patch)
Licensed under: GPL-3.0 (https://www.gnu.org/licenses/gpl-3.0.html)

Budget large Servux pastes with spare region tick time. Pause block-related work in edited sections and retain due block/fluid ticks. Cancel queued pastes before native shutdown draining.

Co-authored-by: wdsj-cmd <125710718+wdsj-cmd@users.noreply.github.com>

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index c43e8f9ac33a31fd84b596030d0467978aaf568f..fbc4dfd82963f69215cbbf7dc6c7e81af49ffba7 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1039,6 +1039,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     // Folia end - region threading
 
     public void stopServer() { // Folia - region threading - public
+        org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.shutdown(this); // Lophine - cancel queued Servux pastes before native draining
         // Folia start - region threading
         // halt scheduler
         // don't wait, we may be on a scheduler thread
@@ -1175,6 +1176,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.halt(wait, false);
     }
     public void halt(final boolean wait, final boolean isRestarting) {
+        org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.shutdown(this); // Lophine - cancel queued Servux pastes before native draining
         this.isRestarting = isRestarting;
         this.hasLoggedStop = true; // Paper - Debugging
         if (this.isDebugging()) io.papermc.paper.util.TraceUtil.dumpTraceForThread("Server stopped"); // Paper - Debugging
@@ -1805,6 +1807,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         ProfilerFiller profiler = Profiler.get();
         //this.server.spark.executeMainThreadTasks(); // Paper - spark // Folia - region threading
+        if (region != null) org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.tick(region.world, scheduledEnd); // Lophine - use spare region tick time for Servux
         // Paper start - Server Tick Events
         long endTime = System.nanoTime();
         long remaining = scheduledEnd - endTime; // Folia - region ticking
diff --git a/net/minecraft/server/ServerTickRateManager.java b/net/minecraft/server/ServerTickRateManager.java
index 8432d0ce22ddc9c9bfa98901e403697f40e53c99..9ec141359c4422c1574dac71a88b7f5043350901 100644
--- a/net/minecraft/server/ServerTickRateManager.java

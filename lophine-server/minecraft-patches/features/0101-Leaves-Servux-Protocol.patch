diff --git a/net/minecraft/world/ticks/LevelTicks.java b/net/minecraft/world/ticks/LevelTicks.java
index 52a7da01ce84b93a4444a002effa261d20e1a707..ac75b3d72692e9543a1ec410f3766a30df09d666 100644
--- a/net/minecraft/world/ticks/LevelTicks.java
+++ b/net/minecraft/world/ticks/LevelTicks.java
@@ -152,7 +152,7 @@ public class LevelTicks<T> implements LevelTickAccess<T> {
         this.collectTicks(currentTick, maxTicksToProcess, profiler);
         profiler.popPush("run");
         profiler.incrementCounter("ticksToRun", this.toRunThisTick.size());
-        this.runCollectedTicks(output);
+        this.runCollectedTicks(currentTick, output);
         profiler.popPush("cleanup");
         this.cleanupAfterTick();
         profiler.pop();
@@ -247,7 +247,7 @@ public class LevelTicks<T> implements LevelTickAccess<T> {
         return this.toRunThisTick.size() < maxTicksToProcess;
     }
 
-    private void runCollectedTicks(final BiConsumer<BlockPos, T> output) {
+    private void runCollectedTicks(final long currentTick, final BiConsumer<BlockPos, T> output) {
         // Folia start - profiler
         io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler().addCounter(
             ca.spottedleaf.leafprofiler.LProfilerRegistry.BLOCK_OR_FLUID_TICK_COUNT,
@@ -260,6 +260,12 @@ public class LevelTicks<T> implements LevelTickAccess<T> {
                 this.toRunThisTickSet.remove(entry);
             }
 
+            // Lophine start - keep paused ticks in their native persistent queue
+            if (org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.isPaused(this.world, entry.pos())) {
+                this.schedule(new ScheduledTick<>(entry.type(), entry.pos(), currentTick + 1L, entry.priority(), entry.subTickOrder()));
+                continue;
+            }
+            // Lophine end - keep paused ticks in their native persistent queue
             this.alreadyRunThisTick.add(entry);
             output.accept(entry.pos(), entry.type());
         }

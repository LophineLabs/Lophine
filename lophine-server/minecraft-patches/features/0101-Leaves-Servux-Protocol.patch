             final LevelChunkSection section = sections[sectionIndex];
             final net.minecraft.world.level.chunk.PalettedContainer<net.minecraft.world.level.block.state.BlockState> states = section.getStates();
             if (!section.isRandomlyTickingBlocks()) {
@@ -1188,6 +1189,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public void tickPrecipitation(final BlockPos pos) {
         BlockPos topPos = this.getHeightmapPos(Heightmap.Types.MOTION_BLOCKING, pos);
         BlockPos belowPos = topPos.below();
+        if (org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.isPaused(this, topPos) || org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.isPaused(this, belowPos)) return; // Lophine - pause precipitation while pasting
         Biome biome = this.getBiome(topPos).value();
         if (biome.shouldFreeze(this, belowPos)) {
             org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, belowPos, Blocks.ICE.defaultBlockState(), Block.UPDATE_ALL, null); // CraftBukkit
@@ -2292,6 +2294,10 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         BlockEventData eventData;
         while ((eventData = worldRegionData.removeFirstBlockEvent()) != null) {
             // Folia end - regionised ticking
+            if (org.leavesmc.leaves.protocol.servux.litematics.ServuxPasteManager.isPaused(this, eventData.pos())) { // Lophine - retain paused redstone events
+                blockEventsToReschedule.add(eventData);
+                continue;
+            }
             if (this.shouldTickBlocksAt(eventData.pos())) {
                 if (this.doBlockEvent(eventData)) {
                     this.server
@@ -2880,6 +2886,8 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             this.server.updateEffectiveRespawnData();
         }
         // Paper end
+
+        org.leavesmc.leaves.protocol.servux.ServuxHudDataProtocol.refreshSpawnMetadata = true; // Leaves - servux
     }
 
     @Override

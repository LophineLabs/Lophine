+                    && impact.position().distanceToSqr(target.position()) <= Mth.square(200.0);
+                // Goat inherits LivingEntity.blockedByItem: the response mutates only the defender.
+                if (response && blocked < damage) target.knockback(0.5, target.getX() - impact.position().x, target.getZ() - impact.position().z,
+                    impact.source(), damage, body, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.SHIELD_BLOCK);
+                return response;
+            }).thenCompose(carpet.script.external.ScarpetRuntime.captureNativeFunction(response ->
+                carpet.script.external.ScarpetNativeDeathActors.target(target, () -> {
+                    if (response && target instanceof net.minecraft.world.entity.player.Player && impact.disableSeconds() > 0.0F) {
+                        var item = target.getItemBlockingWith();
+                        var blocks = item == null ? null : item.get(net.minecraft.core.component.DataComponents.BLOCKS_ATTACKS);
+                        if (blocks != null) blocks.disable((ServerLevel) target.level(), target, impact.disableSeconds(), item, body);
+                    }
+                    return blocked;
+                })))));
+    }

+    private int repairAllPlayerItems(ServerPlayer player, int value) {
+        int remaining = value;
+        List<ItemStack> repairList = new java.util.ArrayList<>();
+        net.minecraft.world.Container inventory = player.getInventory();
+        for (int slot = 0; slot < inventory.getContainerSize(); slot++) {

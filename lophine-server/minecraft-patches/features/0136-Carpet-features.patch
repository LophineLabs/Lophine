+    private java.util.concurrent.CompletableFuture<Float> carpetRamBlockingAsync(final Goat body, final LivingEntity target,
+        final CarpetRamImpact impact, final float damage) {
+        return carpet.script.external.ScarpetNativeDeathActors.target(target, () -> {
+            if (damage <= 0.0F) return 0.0F;
+            var item = target.getItemBlockingWith();
+            if (item == null) return 0.0F;
+            var blocks = item.get(net.minecraft.core.component.DataComponents.BLOCKS_ATTACKS);
+            if (blocks == null || blocks.bypassedBy().map(tag -> tag.contains(impact.source().typeHolder())).orElse(false)) return 0.0F;
+            Vec3 sourcePosition = impact.source().sourcePositionRaw() == null ? impact.position() : impact.source().sourcePositionRaw();
+            Vec3 view = net.minecraft.world.entity.Entity.calculateViewVector(0.0F, target.getYHeadRot());
+            Vec3 direction = sourcePosition.subtract(target.position());
+            double angle = Math.acos(new Vec3(direction.x, 0.0, direction.z).normalize().dot(view));
+            float blocked = blocks.resolveBlockedDamage(impact.source(), damage, angle);

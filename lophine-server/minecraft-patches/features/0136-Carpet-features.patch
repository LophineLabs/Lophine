+package net.minecraft.world.entity;
+
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.sounds.SoundEvents;
+import net.minecraft.tags.ItemTags;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.entity.boss.enderdragon.EnderDragon;
+import net.minecraft.world.entity.player.Player;
+
+public final class CarpetEntityRemoval {
+    private CarpetEntityRemoval() {
+    }
+
+    public static boolean canRemove(final Entity entity) {
+        return !(entity instanceof Player) && EntitySelector.NO_SPECTATORS.test(entity);
+    }
+
+    public static boolean remove(final Entity entity) {
+        if (!canRemove(entity)) {
+            return false;
+        }
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(entity)) {
+            return entity.getBukkitEntity().taskScheduler.schedule(CarpetEntityRemoval::remove, null, 1L);
+        }
+        if (entity.isRemoved()) {
+            return false;
+        }
+        if (entity instanceof EnderDragon dragon) {
+            for (Entity part : dragon.getSubEntities()) {
+                part.carpetDiscardCleanly();
+            }
+        }
+        entity.carpetDiscardCleanly();
+        return true;
+    }
+
+    public static void removeHit(final ServerPlayer player, final Entity victim) {
+        boolean sweep = player.getItemInHand(InteractionHand.MAIN_HAND).is(ItemTags.SWORDS)
+            && player.onGround() && !player.isSprinting();
+        if (sweep) {
+            for (Entity nearby : player.level().getEntitiesOfClass(Entity.class, victim.getBoundingBox().inflate(1.0, 0.25, 1.0))) {
+                if (nearby != player && nearby != victim && canRemove(nearby) && player.distanceToSqr(nearby) < 9.0) {
+                    remove(nearby);
+                }
+            }
+        }
+        remove(victim);
+        player.level().playSound(null, player.getX(), player.getY(), player.getZ(),
+            sweep ? SoundEvents.PLAYER_ATTACK_SWEEP : SoundEvents.PLAYER_ATTACK_STRONG, player.getSoundSource(), 0.7F, 0.9F);
+    }
+}

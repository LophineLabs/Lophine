+            }
+            return true;
+        }
+
+        // Disabling player loading removes its generation/simulation tickets while
+        // retaining visibility of chunks that other players or loaders keep active.
+        private void carpetSendAlreadyLoadedChunks() {
+            this.sendQueue.clear();
+            final var sent = this.sentChunks.iterator();
+            while (sent.hasNext()) {
+                final long key = sent.nextLong();
+                final int x = CoordinateUtils.getChunkX(key);
+                final int z = CoordinateUtils.getChunkZ(key);
+                if (!this.wantChunkSent(x, z) || ((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(x, z) == null) {
+                    sent.remove();
+                    this.sendUnloadChunkRaw(x, z);
+                    if (this.removed) {
+                        return;
+                    }
+                }
+            }
+            for (long offset : ParallelSearchRadiusIteration.getEuclideanIteration(this.lastSendDistance + 1)) {
+                final int x = this.lastChunkX + CoordinateUtils.getChunkX(offset);
+                final int z = this.lastChunkZ + CoordinateUtils.getChunkZ(offset);
+                final long key = CoordinateUtils.getChunkKey(x, z);
+                if (this.wantChunkSent(x, z) && !this.sentChunks.contains(key)
+                    && TickThread.isTickThreadFor(this.world, x, z) && this.carpetNeighboursReady(x, z)) {
+                    this.sendQueue.enqueue(key);
+                }
+            }
+            final long sends = this.chunkSendLimiter.takeAllocation(Math.min(MAX_RATE, this.sendQueue.size()));
+            for (long i = 0; i < sends; ++i) {
+                final long key = this.sendQueue.dequeueLong();
+                this.sendChunk(CoordinateUtils.getChunkX(key), CoordinateUtils.getChunkZ(key));
+                if (this.removed) {
+                    return;
+                }
+            }
+        }

+        private boolean carpetNeighboursReady(final int chunkX, final int chunkZ) {
+            for (int dz = -1; dz <= 1; ++dz) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    final LevelChunk chunk = ((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(chunkX + dx, chunkZ + dz);

@@ -159,6 +159,15 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         return this.paperConfig;
     }
     // Paper end - add paper world config
+    // Lophine start - per-world config
+    private me.earthme.luminol.config.WorldConfigHolder luminolWorldConfig = me.earthme.luminol.config.WorldConfigHolder.empty();

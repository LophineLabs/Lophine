@@ -608,6 +608,12 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         // CraftBukkit end
         this.tickTime = tickTime;
         this.server = server;
+        // Lophine start - per-world config
+        this.luminolWorldConfig(me.earthme.luminol.config.ConfigManager.loadWorldConfigs(
+            loadedWorldData.bukkitName(),
+            server.storageSource.getDimensionPath(dimension).toFile()
+        ));
+        // Lophine end - per-world config
         this.customSpawners = customSpawners;
         this.serverLevelData = levelData;
         ChunkGenerator generator = levelStem.generator();
@@ -1630,6 +1636,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public void saveLevelData(final boolean sync) { // Folia - public
         SavedDataStorage savedDataStorage = this.getChunkSource().getDataStorage();
         savedDataStorage.computeIfAbsent(io.papermc.paper.world.saveddata.PaperWorldPDC.TYPE).setFrom(this.persistentDataContainer); // Paper
+        this.luminolWorldConfig().save(); // Lophine - per-world config
         if (sync) {
             savedDataStorage.saveAndJoin();
         } else {

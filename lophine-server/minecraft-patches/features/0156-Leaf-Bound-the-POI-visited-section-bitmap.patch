@@ -31,6 +31,69 @@ public final class PoiAccess {
 
     public static final boolean LOAD_FOR_SEARCHING = true;
 
+    // Leaf start - Optimize PoiAccess visited section tracking
+    private static final class SectionVisitSet {
+        private static final int MAX_BITMAP_SECTIONS = 16_384;
+        private final int minX;
+        private final int minY;
+        private final int minZ;
+        private final int sizeX;
+        private final int sizeY;
+        private final long[] words;
+        private final LongOpenHashSet sparse;
+
+        private SectionVisitSet(
+            final int lowerX, final int lowerY, final int lowerZ,
+            final int upperX, final int upperY, final int upperZ,
+            final int centerX, final int centerY, final int centerZ
+        ) {
+            // The queue also sees neighbors one section beyond the search bounds.
+            this.minX = lowerX - 1;
+            this.minY = lowerY - 1;
+            this.minZ = lowerZ - 1;
+            final long width = (long)upperX - lowerX + 3L;
+            final long height = (long)upperY - lowerY + 3L;
+            final long depth = (long)upperZ - lowerZ + 3L;
+            this.sizeX = (int)width;
+            this.sizeY = (int)height;
+            if (centerX >= lowerX && centerX <= upperX && centerY >= lowerY && centerY <= upperY && centerZ >= lowerZ && centerZ <= upperZ
+                && width <= MAX_BITMAP_SECTIONS && height <= MAX_BITMAP_SECTIONS && depth <= MAX_BITMAP_SECTIONS
+                && width * height * depth <= MAX_BITMAP_SECTIONS
+                && canPack(this.minX, this.minY, this.minZ)
+                && canPack(upperX + 1, upperY + 1, upperZ + 1)) {
+                this.words = new long[(int)((width * height * depth + 63L) >>> 6)];
+                this.sparse = null;
+            } else {
+                this.words = null;
+                this.sparse = new LongOpenHashSet();
+            }
+        }
+
+        private static boolean canPack(final int x, final int y, final int z) {
+            final long key = CoordinateUtils.getChunkSectionKey(x, y, z);
+            return CoordinateUtils.getChunkSectionX(key) == x
+                && CoordinateUtils.getChunkSectionY(key) == y
+                && CoordinateUtils.getChunkSectionZ(key) == z;
+        }
+
+        private boolean add(final int x, final int y, final int z, final long key) {
+            if (this.words == null) {
+                return this.sparse.add(key);
+            }
+
+            final int index = ((z - this.minZ) * this.sizeX + (x - this.minX)) * this.sizeY + (y - this.minY);
+            final int word = index >>> 6;
+            final long mask = 1L << (index & 63);
+            final long old = this.words[word];
+            if ((old & mask) != 0L) {
+                return false;
+            }
+            this.words[word] = old | mask;
+            return true;
+        }
+    }
+    // Leaf end - Optimize PoiAccess visited section tracking
+
     public static int compareDistances(final double d1, final double d2) {
         // we assume that the values are reasonably finite
 
@@ -117,8 +180,8 @@ public final class PoiAccess {
         final long centerKey = CoordinateUtils.getChunkSectionKey(centerX, centerY, centerZ);
 
         final LongArrayFIFOQueue queue = new LongArrayFIFOQueue();
-        final LongOpenHashSet seen = new LongOpenHashSet();
-        seen.add(centerKey);
+        final SectionVisitSet seen = new SectionVisitSet(lowerX, lowerY, lowerZ, upperX, upperY, upperZ, centerX, centerY, centerZ); // Leaf - Optimize PoiAccess visited section tracking
+        seen.add(centerX, centerY, centerZ, centerKey);
         queue.enqueue(centerKey);
 
         while (!queue.isEmpty()) {
@@ -160,7 +223,7 @@ public final class PoiAccess {
                         final int neighbourZ = sectionZ + dz;
 
                         final long neighbourKey = CoordinateUtils.getChunkSectionKey(neighbourX, neighbourY, neighbourZ);
-                        if (seen.add(neighbourKey)) {
+                        if (seen.add(neighbourX, neighbourY, neighbourZ, neighbourKey)) { // Leaf - Optimize PoiAccess visited section tracking
                             queue.enqueue(neighbourKey);
                         }
                     }
@@ -360,8 +423,8 @@ public final class PoiAccess {
         final long centerKey = CoordinateUtils.getChunkSectionKey(centerX, centerY, centerZ);
 
         final LongArrayFIFOQueue queue = new LongArrayFIFOQueue();
-        final LongOpenHashSet seen = new LongOpenHashSet();
-        seen.add(centerKey);
+        final SectionVisitSet seen = new SectionVisitSet(lowerX, lowerY, lowerZ, upperX, upperY, upperZ, centerX, centerY, centerZ); // Leaf - Optimize PoiAccess visited section tracking
+        seen.add(centerX, centerY, centerZ, centerKey);
         queue.enqueue(centerKey);
 
         while (!queue.isEmpty()) {
@@ -404,7 +467,7 @@ public final class PoiAccess {
                         final int neighbourZ = sectionZ + dz;
 
                         final long neighbourKey = CoordinateUtils.getChunkSectionKey(neighbourX, neighbourY, neighbourZ);
-                        if (seen.add(neighbourKey)) {
+                        if (seen.add(neighbourX, neighbourY, neighbourZ, neighbourKey)) { // Leaf - Optimize PoiAccess visited section tracking
                             queue.enqueue(neighbourKey);
                         }

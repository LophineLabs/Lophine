--- /dev/null
+++ b/net/minecraft/world/level/block/CarpetLargeBarrel.java
@@ -0,0 +1,81 @@
+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ * Derived from Carpet TIS Addition, Fallen_Breath and contributors.
+ * Upstream revision: 62c3cb6fff26cd9c4e12aa616b403c184a4a6ca0.
+ */
+package net.minecraft.world.level.block;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.CompoundContainer;
+import net.minecraft.world.Container;
+import net.minecraft.world.MenuProvider;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.ChestMenu;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.entity.BarrelBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import org.jspecify.annotations.Nullable;
+
+public final class CarpetLargeBarrel {
+    private CarpetLargeBarrel() {
+    }
+
+    public static @Nullable Container getContainer(final BlockState state, final Level level, final BlockPos pos) {
+        if (!(state.getBlock() instanceof BarrelBlock)
+            || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, pos)
+            || !(level.getBlockEntity(pos) instanceof BarrelBlockEntity barrel)) {
+            return null;
+        }
+        Direction facing = state.getValue(BarrelBlock.FACING);
+        BlockPos otherPos = pos.relative(facing.getOpposite());
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, otherPos)) {
+            return barrel;
+        }
+        BlockState otherState = level.getBlockStateIfLoaded(otherPos);
+        if (otherState == null || !(otherState.getBlock() instanceof BarrelBlock)
+            || otherState.getValue(BarrelBlock.FACING) != facing.getOpposite()
+            || !(level.getBlockEntity(otherPos) instanceof BarrelBlockEntity other)
+            || barrel.getContainerSize() != 27 || other.getContainerSize() != 27) {
+            // Preserve containers expanded by Lophine's separate barrelRows setting.
+            return barrel;
+        }
+        return facing.getAxisDirection() == Direction.AxisDirection.NEGATIVE
+            ? new CompoundContainer(barrel, other) : new CompoundContainer(other, barrel);
+    }
+
+    public static @Nullable MenuProvider getMenuProvider(final BlockState state, final Level level, final BlockPos pos) {
+        Container container = getContainer(state, level, pos);
+        if (container instanceof BarrelBlockEntity single) {
+            return single;
+        }
+        if (!(container instanceof CompoundContainer combined)
+            || !(combined.container1 instanceof BarrelBlockEntity first)
+            || !(combined.container2 instanceof BarrelBlockEntity second)) {
+            return null;
+        }
+        MenuProvider provider = new MenuProvider() {
+            @Override
+            public @Nullable AbstractContainerMenu createMenu(final int syncId, final Inventory inventory, final Player player) {
+                if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, first.getBlockPos())
+                    || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, second.getBlockPos())
+                    || !first.canOpen(player) || !second.canOpen(player)) {
+                    return null;
+                }
+                first.unpackLootTable(player);
+                second.unpackLootTable(player);
+                return ChestMenu.sixRows(syncId, inventory, combined);
+            }
+
+            @Override
+            public Component getDisplayName() {
+                return first.getCustomName() != null ? first.getDisplayName()
+                    : second.getCustomName() != null ? second.getDisplayName() : Component.translatable("container.barrel");
+            }
+        };
+        return org.bukkit.craftbukkit.inventory.CraftInventoryDoubleChest.Provider.wrap(provider, combined);
+    }
+}

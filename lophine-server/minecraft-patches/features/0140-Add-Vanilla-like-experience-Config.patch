diff --git a/net/minecraft/core/dispenser/CarpetDragonBreathDispenseBehavior.java b/net/minecraft/core/dispenser/CarpetDragonBreathDispenseBehavior.java
new file mode 100644
index 0000000000000000000000000000000000000000..bb99e7e619aa8b19fe142c5fb5f56bf4e09f4238
--- /dev/null
+++ b/net/minecraft/core/dispenser/CarpetDragonBreathDispenseBehavior.java
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Derived from Carpet TIS Addition, Fallen_Breath and contributors.
+ * Upstream revision: 62c3cb6fff26cd9c4e12aa616b403c184a4a6ca0.
+ */
+package net.minecraft.core.dispenser;
+
+import carpet.script.external.*;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Supplier;
+import java.util.function.BooleanSupplier;
+import net.minecraft.core.*;
+import net.minecraft.core.particles.*;
+import net.minecraft.world.effect.*;
+import net.minecraft.world.entity.AreaEffectCloud;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.alchemy.PotionContents;
+import net.minecraft.world.level.block.*;
+import net.minecraft.world.phys.Vec3;
+
+/** Native receipt keeps callback, target spawn and original source effects in their real order. */
+public final class CarpetDragonBreathDispenseBehavior extends DefaultDispenseItemBehavior {
+    private record Header(Direction direction, org.bukkit.inventory.ItemStack original, org.bukkit.event.block.BlockDispenseEvent event) { }
+    private record Selection(ItemStack dispensed, boolean noCost) { }
+    private record Cloud(AreaEffectCloud entity, MobEffectInstance damage) { }
+    public CompletableFuture<Void> carpetDispenseSelectedAsync(BlockSource source, int slot, ItemStack originalStack) {
+        BooleanSupplier validSlot = () -> source.blockEntity().getItem(slot) == originalStack;
+        return job(source, () -> sourceAt(source, validSlot, () -> org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockPreDispenseEvent(
+            source.level(), source.pos(), originalStack, slot)).thenCompose(ScarpetRuntime.captureNativeFunction(accepted -> {
+                if (!accepted) return CompletableFuture.completedFuture(null);
+                return sourceAt(source, validSlot, () -> {
+                    boolean noCost = fun.bm.lophine.carpet.config.modules.GeneralCompatConfig.dispenserNoItemCost;
+                    return new Selection(noCost ? originalStack.copy() : originalStack, noCost);
+                }).thenCompose(ScarpetRuntime.captureNativeFunction(selection -> carpetDispenseAsync(source, selection.dispensed(), validSlot)
+                    .thenCompose(ScarpetRuntime.captureNativeFunction(remaining -> sourceAt(source, validSlot, () -> {
+                        if (!selection.noCost()) source.blockEntity().setItem(slot, remaining); return (Void)null;
+                    })))));
+            })));
+    }
+    public CompletableFuture<ItemStack> carpetDispenseAsync(BlockSource source, ItemStack dispensed) {
+        return this.carpetDispenseAsync(source, dispensed, () -> true);
+    }
+    private CompletableFuture<ItemStack> carpetDispenseAsync(BlockSource source, ItemStack dispensed, BooleanSupplier validSlot) {
+        return job(source, () -> begin(source, dispensed, validSlot).thenCompose(ScarpetRuntime.captureNativeFunction(header -> execute(source, dispensed, header, validSlot)
+            .thenCompose(ScarpetRuntime.captureNativeFunction(remaining -> sourceAt(source, validSlot, () -> { this.playSound(source); return remaining; })))
+            .thenCompose(ScarpetRuntime.captureNativeFunction(remaining -> sourceAt(source, validSlot, () -> { this.playAnimation(source, header.direction()); return remaining; }))))));
+    }
+    @Override protected ItemStack execute(BlockSource source, ItemStack dispensed) {
+        // Retain the protected execute entry separately from the complete Default sound/animation wrapper.
+        ScarpetNativeWork.record(job(source, () -> begin(source, dispensed, () -> true).thenCompose(ScarpetRuntime.captureNativeFunction(header -> execute(source, dispensed, header, () -> true)))));
+        return dispensed;
+    }
+    private CompletableFuture<Header> begin(BlockSource source, ItemStack dispensed, BooleanSupplier validSlot) {
+        return sourceAt(source, validSlot, () -> {
+            Direction direction = source.state().getValue(DispenserBlock.FACING);
+            Vec3 target = Vec3.atCenterOf(source.pos().relative(direction));
+            var original = org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitCopy(dispensed.copyWithCount(1));
+            var event = new org.bukkit.event.block.BlockDispenseEvent(org.bukkit.craftbukkit.block.CraftBlock.at(source.level(), source.pos()),
+                original.clone(), org.bukkit.craftbukkit.util.CraftVector.toBukkit(target));
+            source.level().getCraftServer().getPluginManager().callEvent(event);
+            return new Header(direction, original, event);
+        });
+    }
+    private CompletableFuture<ItemStack> execute(BlockSource source, ItemStack dispensed, Header header, BooleanSupplier validSlot) {
+        // Inspect the real event object only after its native callback children have completed.
+        return sourceAt(source, validSlot, () -> {
+            var event = header.event();
+            if (event.isCancelled()) return CompletableFuture.completedFuture(dispensed);
+            boolean consume = event.getItem().equals(header.original());
+            if (!consume) {
+                ItemStack replacement = org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(event.getItem());
+                DispenseItemBehavior behavior = DispenserBlock.getDispenseBehavior(source, replacement);
+                if (behavior != DispenseItemBehavior.NOOP && !(behavior instanceof CarpetDragonBreathDispenseBehavior))
+                    return sourceAt(source, validSlot, () -> { behavior.dispense(source, replacement); return dispensed; });
+            }
+            Vec3 target = org.bukkit.craftbukkit.util.CraftVector.toVec3(event.getVelocity());
+            if (!Double.isFinite(target.x()) || !Double.isFinite(target.y()) || !Double.isFinite(target.z())) return CompletableFuture.completedFuture(dispensed);
+            BlockPos position = BlockPos.containing(target);
+            // Preserve original source construction/RNG admission before target attachment.
+            return sourceAt(source, validSlot, () -> {
+                AreaEffectCloud cloud = new AreaEffectCloud(source.level(), target.x(), target.y(), target.z());
+                cloud.setOwner(null); cloud.setCustomParticle(PowerParticleOption.create(ParticleTypes.DRAGON_BREATH, 1.0F));
+                cloud.setRadius(3.0F); cloud.setDuration(600); cloud.setRadiusPerTick((7.0F - cloud.getRadius()) / cloud.getDuration());
+                MobEffectInstance damage = new MobEffectInstance(MobEffects.INSTANT_DAMAGE, 1, 1); cloud.addEffect(damage);
+                return new Cloud(cloud, damage);
+            }).thenCompose(ScarpetRuntime.captureNativeFunction(cloud -> at(source, position, () -> {
+                source.level().levelEvent(LevelEvent.PARTICLES_INSTANT_POTION_SPLASH, position,
+                    PotionContents.getColorOptional(java.util.Collections.singleton(cloud.damage())).orElse(0xFF385DC6)); return (Void)null;
+            }).thenCompose(ScarpetRuntime.captureNativeFunction(ignored -> at(source, position, () -> source.level().addFreshEntity(cloud.entity()))))
+                .thenCompose(ScarpetRuntime.captureNativeFunction(ignored -> sourceAt(source, validSlot, () -> { if (consume) dispensed.shrink(1); return dispensed; })))));
+        }).thenCompose(ScarpetRuntime.captureNativeFunction(value -> value));
+    }
+    private static <T> CompletableFuture<T> sourceAt(BlockSource source, BooleanSupplier validSlot, Supplier<T> body) {
+        return at(source, source.pos(), () -> {
+            // Registry identity must be checked before reading a block entity that may have moved to another owner.
+            var entity = source.blockEntity();
+            if (source.level().getBlockEntity(source.pos()) != entity || entity.isRemoved()
+                || entity.getLevel() != source.level() || !source.pos().equals(entity.getBlockPos()) || !validSlot.getAsBoolean()) {
+                throw new IllegalStateException("Dragon breath dispenser source changed during native work");
+            }
+            return body.get();
+        });
+    }
+    private static <T> CompletableFuture<T> at(BlockSource source, BlockPos position, Supplier<T> body) {
+        var result = ScarpetExplosionActors.world(source.level(), position, () -> {
+            var observed = ScarpetNativeWork.observeNative(null, body); ScarpetNativeWork.trackNative(source.level().getServer(), observed);
+            return ScarpetNativeWork.recoverGuestValue(observed);
+        }).thenCompose(ScarpetRuntime.captureNativeFunction(value -> value));
+        ScarpetNativeWork.record(result); return result;
+    }
+    private static <T> CompletableFuture<T> job(BlockSource source, Supplier<CompletableFuture<T>> body) {
+        var actual = new CompletableFuture<T>() { @Override public boolean cancel(boolean interrupt) { return false; } };
+        ScarpetNativeWork.record(actual);
+        try {
+            ScarpetNativeWork.trackNative(source.level().getServer(), actual);
+            var observed = ScarpetNativeWork.observeNative(null, () -> { var value = body.get(); ScarpetNativeWork.record(value); return value; });
+            ScarpetNativeWork.trackNative(source.level().getServer(), observed); ScarpetNativeWork.aliasDependency(actual, observed);
+            ScarpetNativeWork.recoverGuestValue(observed).thenCompose(ScarpetRuntime.captureNativeFunction(value -> value)).whenComplete((value, failure) -> {
+                if (failure == null) actual.complete(value); else actual.completeExceptionally(failure);
+            });
+        } catch (Throwable failure) { actual.completeExceptionally(failure); }
+        return actual;
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wdsj-cmd <125710718+wdsj-cmd@users.noreply.github.com>
Date: Fri, 6 Nov 2026 00:45:57 +0800
Subject: [PATCH] Keep incremental block updates independent of neighbour send
 readiness


diff --git a/net/minecraft/server/level/ChunkHolder.java b/net/minecraft/server/level/ChunkHolder.java
index cd5a325d37f617431ceb568a655701601618198f..5de2eba211296538c0e700ea1f7412bdb2fdd154 100644
--- a/net/minecraft/server/level/ChunkHolder.java
+++ b/net/minecraft/server/level/ChunkHolder.java
@@ -221,7 +221,8 @@ public class ChunkHolder extends GenerationChunkHolder implements ca.spottedleaf
     }
 
     public boolean blockChanged(final BlockPos pos) {
-        LevelChunk chunk = this.playersSentChunkTo.size() == 0 ? null : this.getChunkToSend(); // Paper - rewrite chunk system
+        // Lophine - incremental updates target existing recipients; only initial chunk sends require ready neighbours.
+        LevelChunk chunk = this.playersSentChunkTo.size() == 0 ? null : this.moonrise$getFullChunk();
         if (chunk == null) {
             return false;
         }
@@ -247,7 +248,8 @@ public class ChunkHolder extends GenerationChunkHolder implements ca.spottedleaf
         }
 
         chunk.markUnsaved();
-        LevelChunk tickingChunk = this.playersSentChunkTo.size() == 0 ? null : this.getChunkToSend(); // Paper - rewrite chunk system
+        // Lophine - incremental updates target existing recipients; only initial chunk sends require ready neighbours.
+        LevelChunk tickingChunk = this.playersSentChunkTo.size() == 0 ? null : this.moonrise$getFullChunk();
         if (tickingChunk == null) {
             return false;
         }
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 5a0b26f5da31f8a58c5d0cd8dd8611ea880fda24..5eb0598c43440af6468ac2ce19e429e2a67010b7 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -572,7 +572,8 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         profiler.push("broadcast");
 
         for (ChunkHolder chunkHolder : regionizedWorldData.chunkHoldersToBroadcast) { // Folia - region threading - note: do not need to thread check, as getChunkToSend is only non-null when the chunkholder is loaded
-            LevelChunk chunk = chunkHolder.getChunkToSend(); // Paper - rewrite chunk system
+            // Lophine - neighbours may temporarily be unavailable after this chunk was already sent.
+            LevelChunk chunk = chunkHolder.moonrise$getFullChunk();
             if (chunk != null) {
                 chunkHolder.broadcastChanges(chunk);
             }

+
+    companion object {
+        private val SIGNATURE_FILES = setOf(
+            "META-INF/MOJANGCS.SF",
+            "META-INF/MOJANGCS.RSA",
+            "META-INF/MOJANGCS.DSA",
+        )
+
+        private fun isBinaryResource(name: String): Boolean =
+            name.endsWith(".class") || name.endsWith(".png") || name.endsWith(".nbt") || name.endsWith(".dat")
+
+        private fun normalizeText(bytes: ByteArray): ByteArray {
+            val text = String(bytes, Charsets.ISO_8859_1).replace("\r\n", "\n")
+            var end = text.length
+            while (end > 0 && text[end - 1] == '\n') end--
+            return text.substring(0, end).toByteArray(Charsets.ISO_8859_1)
+        }
+
+        fun optimizeServerJar(vanillaJar: java.nio.file.Path, serverJar: java.nio.file.Path) {
+            val serverEntries = LinkedHashMap<String, ByteArray>()
+            val serverTimes = HashMap<String, Long>()
+            ZipFile(serverJar.toFile()).use { zs ->
+                for (entry in zs.entries()) {
+                    if (entry.isDirectory || entry.name in SIGNATURE_FILES) continue
+                    serverEntries[entry.name] = zs.getInputStream(entry).use { it.readBytes() }
+                    serverTimes[entry.name] = entry.time
+                }
+            }
+
+            val temp = serverJar.resolveSibling("${serverJar.fileName}.tmp")
+            val written = HashSet<String>()
+            val writtenDirs = HashSet<String>()
+
+            fun writeParentDirs(out: ZipOutputStream, entryName: String, time: Long) {
+                var slash = entryName.indexOf('/')
+                while (slash > 0) {
+                    val dir = entryName.substring(0, slash + 1)
+                    if (writtenDirs.add(dir)) {
+                        out.putNextEntry(ZipEntry(dir).also {
+                            it.time = time
+                            it.method = ZipEntry.STORED
+                            it.size = 0
+                            it.compressedSize = 0
+                            it.crc = 0
+                        })
+                        out.closeEntry()
+                    }
+                    slash = entryName.indexOf('/', slash + 1)
+                }
+            }
+
+            ZipFile(vanillaJar.toFile()).use { zv ->
+                ZipOutputStream(Files.newOutputStream(temp).buffered()).use { out ->
+                    for (ve in zv.entries()) {
+                        if (ve.isDirectory) continue
+                        val name = ve.name
+                        val sBytes = serverEntries[name] ?: continue
+                        val vBytes = zv.getInputStream(ve).use { it.readBytes() }
+                        val matches = vBytes.contentEquals(sBytes) ||
+                            (!isBinaryResource(name) && normalizeText(vBytes).contentEquals(normalizeText(sBytes)))
+                        if (matches) {
+                            writeParentDirs(out, name, ve.time)
+                            out.putNextEntry(ZipEntry(name).also {
+                                it.time = ve.time
+                                it.method = ZipEntry.DEFLATED
+                            })
+                            out.write(vBytes)
+                            out.closeEntry()
+                            written.add(name)
+                        }
+                    }
+
+                    val crc = CRC32()
+                    for (name in serverEntries.keys.filter { it !in written }.sorted()) {
+                        val data = serverEntries.getValue(name)
+                        val time = serverTimes.getOrDefault(name, 0L)
+                        writeParentDirs(out, name, time)
+                        crc.reset()
+                        crc.update(data)
+                        out.putNextEntry(ZipEntry(name).also {
+                            it.time = time
+                            it.method = ZipEntry.STORED
+                            it.size = data.size.toLong()
+                            it.compressedSize = data.size.toLong()
+                            it.crc = crc.value
+                        })
+                        out.write(data)
+                        out.closeEntry()
+                    }
+                }
+            }
+            Files.move(temp, serverJar, StandardCopyOption.REPLACE_EXISTING)
+        }
+
+        fun repackStoredJar(jarBytes: ByteArray): ByteArray {
+            val outBuffer = ByteArrayOutputStream(jarBytes.size * 2)
+            val entries = ArrayList<Pair<ZipEntry, ByteArray>>()
+            ZipInputStream(jarBytes.inputStream()).use { zin ->
+                while (true) {
+                    val entry = zin.nextEntry ?: break
+                    if (!entry.isDirectory) {
+                        entries.add(entry to zin.readBytes())
+                    }
+                }
+            }
+            entries.sortBy { it.first.name }
+            val writtenDirs = HashSet<String>()
+            val crc = CRC32()
+            ZipOutputStream(outBuffer).use { zout ->
+                for ((entry, data) in entries) {
+                    var slash = entry.name.indexOf('/')
+                    while (slash > 0) {
+                        val dir = entry.name.substring(0, slash + 1)
+                        if (writtenDirs.add(dir)) {
+                            zout.putNextEntry(ZipEntry(dir).also {
+                                it.time = entry.time
+                                it.method = ZipEntry.STORED
+                                it.size = 0
+                                it.compressedSize = 0
+                                it.crc = 0
+                            })
+                            zout.closeEntry()
+                        }
+                        slash = entry.name.indexOf('/', slash + 1)
+                    }
+                    crc.reset()
+                    crc.update(data)
+                    zout.putNextEntry(ZipEntry(entry.name).also {
+                        it.time = entry.time
+                        it.method = ZipEntry.STORED
+                        it.size = data.size.toLong()
+                        it.compressedSize = data.size.toLong()
+                        it.crc = crc.value
+                    })
+                    zout.write(data)
+                    zout.closeEntry()
+                }
+            }
+            return outBuffer.toByteArray()
+        }
+    }
+
+    private class Lib(val sha256: String, val id: String, val path: String, val line: String) {
+        fun normalizedLine(): String {
+            if (!path.endsWith(".jar")) return line
+            val parts = id.split(":")
+            val normalizedId = when (parts.size) {
+                3 -> "$id:jar"
+                4 -> "${parts[0]}:${parts[1]}:${parts[2]}:jar:${parts[3]}"
+                else -> id
+            }
+            return "$sha256\t$normalizedId\t$path"
+        }
+    }
